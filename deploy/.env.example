# 公共 MySQL 信息
SDU_STORY_DB_HOST=mysql.example.internal
SDU_STORY_DB_PORT=3306
SDU_STORY_DB_NAME=replace_me
SDU_STORY_DB_USERNAME=story_user
SDU_STORY_DB_PASSWORD=replace_me

# 至少使用 32 字节的随机值：openssl rand -base64 48
SDU_STORY_APP_JWT_SECRET=replace_with_a_new_random_secret
SDU_STORY_CAS_JWT_SECRET=replace_with_the_rotated_pass_secret

# 获得正式域名后改为 https://正式域名/login-success
SDU_STORY_FRONTEND_LOGIN_SUCCESS_URL=http://127.0.0.1:8001/login-success
SDU_STORY_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8001
