          "portraitRef": "hua/protagonist/young_determined",
          "effectRef": null,
          "orderIndex": 2,
          "condition": null
        },
        {
          "code": "hua_wenshizhe_canteen_004",
          "lineType": "narration",
          "speaker": null,
          "content": "你望着饭盆里渐渐凉下来的饭，思考自己能做什么。",
