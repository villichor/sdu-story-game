          "lineType": "dialogue",
          "speaker": "短发大姐",
          "content": "刚从朝鲜战场退下来呢！国家让俺来念大学，俺还怕走错门呢！",
          "portraitRef": "hua/veteran/proud",
          "effectRef": null,
          "orderIndex": 0,
          "condition": null
        },
        {
          "code": "hua_after_veteran_002",
          "lineType": "narration",
          "speaker": null,
          "content": "你第一次如此真切地意识到，广场上的每一张年轻面孔，背后都可能站着一段惊心动魄的时代。",
          "portraitRef": null,
          "effectRef": null,
          "orderIndex": 1,
          "condition": null
        },
        {
          "code": "hua_after_veteran_003",
          "lineType": "effect",
          "speaker": null,
          "content": "你把她的故事郑重记在笔记本上。",
          "portraitRef": null,
          "effectRef": "collection:hua/veteran_student",
          "orderIndex": 2,
          "condition": null
        }
      ],
      "choices": []
    },
