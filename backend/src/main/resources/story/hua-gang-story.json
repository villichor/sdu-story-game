        {
          "code": "hua_ceremony_meet_001",
          "lineType": "narration",
          "speaker": null,
          "content": "1951年3月19日。广场上黑压压全是人，你抱着笔记本，在人潮里焦急地寻找会场。",
          "portraitRef": null,
          "effectRef": null,
          "orderIndex": 0,
          "condition": null
        },
        {
          "code": "hua_ceremony_meet_002",
          "lineType": "dialogue",
          "speaker": "短发大姐",
          "content": "大妹子，前面搭台子那儿是会场不？",
          "portraitRef": "hua/veteran/curious",
          "effectRef": null,
          "orderIndex": 1,
          "condition": null
        },
        {
          "code": "hua_ceremony_meet_003",
          "lineType": "dialogue",
          "speaker": "你",
          "content": "大姐，我也在找路呢。",
          "portraitRef": "hua/protagonist/young_embarrassed",
          "effectRef": null,
          "orderIndex": 2,
          "condition": null
        },
        {
          "code": "hua_ceremony_meet_004",
          "lineType": "dialogue",
          "speaker": "短发大姐",
          "content": "哎呀，敢情咱俩一样！",
          "portraitRef": "hua/veteran/laughing",
          "effectRef": null,
          "orderIndex": 3,
          "condition": null
        },
        {
          "code": "hua_ceremony_meet_005",
          "lineType": "narration",
          "speaker": null,
          "content": "她后颈有一道浅色旧疤，褪色红绳束着短发，站姿里藏着一种经受过风雪的坚定。",
          "portraitRef": null,
          "effectRef": null,
          "orderIndex": 4,
          "condition": null
        }
      ],
      "choices": [
        {
          "code": "hua_ask_veteran_origin",
          "text": "“您是从哪里来的呀？”",
          "effect": "remember:contact=veteran",
          "toNodeCode": "hua_after_veteran",
          "orderIndex": 0
        },
        {
          "code": "hua_keep_silent_veteran",
