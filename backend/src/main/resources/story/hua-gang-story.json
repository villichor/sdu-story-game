    {
      "code": "hua_ceremony_speech",
      "type": "normal",
      "title": "第二幕：新山大的前途",
      "entry": false,
      "showInStoryline": true,
      "progressPercent": 34,
      "backgroundRef": "hua/act2/ceremony_square",
      "cgRef": "hua/act2/hua_gang_speech",
      "nextNodeCode": null,
      "lines": [
        {
          "code": "hua_ceremony_speech_001",
          "lineType": "narration",
          "speaker": null,
          "content": "广场突然爆发出热烈的欢呼。新任校长华岗走上讲台，灰色干部服朴素整洁，黑框眼镜后的目光温和而坚毅。",
          "portraitRef": null,
          "effectRef": null,
          "orderIndex": 0,
          "condition": null
        },
        {
          "code": "hua_ceremony_speech_002",
          "lineType": "dialogue",
          "speaker": "华岗",
          "content": "同学们，老师们！把原有华东大学和原有山东大学合并，是中国高等教育史上的创举！",
          "portraitRef": "hua/hua_gang/speaking",
          "effectRef": null,
          "orderIndex": 1,
          "condition": null
        },
        {
          "code": "hua_ceremony_speech_003",
          "lineType": "dialogue",
          "speaker": "华岗",
          "content": "各取所长，补己之短。这决不仅仅是数量的加多，更要促进质量的变化和增强！",
          "portraitRef": "hua/hua_gang/determined",
          "effectRef": null,
          "orderIndex": 2,
          "condition": null
        },
        {
          "code": "hua_ceremony_speech_004",
          "lineType": "dialogue",
          "speaker": "华岗",
          "content": "合校要事理兼顾、舍异求同。我们新山大的前途，在座的每一位都有责任！",
          "portraitRef": "hua/hua_gang/determined",
          "effectRef": null,
          "orderIndex": 3,
          "condition": null
        },
        {
          "code": "hua_ceremony_speech_005",
          "lineType": "dialogue",
          "speaker": "华岗",
          "content": "我们要向着新型的、正规的人民大学去发展！",
          "portraitRef": "hua/hua_gang/speaking",
          "effectRef": null,
          "orderIndex": 4,
          "condition": null
        },
        {
          "code": "hua_ceremony_speech_006",
          "lineType": "narration",
          "speaker": null,
          "content": "掌声如潮。你看着台上的校长，又看看身边一张张朝气蓬勃的脸，心中涌起一种从未有过的使命感。",
          "portraitRef": null,
          "effectRef": null,
          "orderIndex": 5,
          "condition": null
        }
      ],
      "choices": [
        {
          "code": "hua_mind_mission",
