      "cgRef": null,
      "nextNodeCode": "hua_letter",
      "lines": [
        {
          "code": "hua_prologue_001",
          "lineType": "narration",
          "speaker": null,
          "content": "午后的阳光落在书架上。你从一只旧木箱里取出一本边角磨损的相册。",
          "portraitRef": null,
          "effectRef": null,
          "orderIndex": 0,
          "condition": null
        },
        {
          "code": "hua_prologue_002",
          "lineType": "narration",
          "speaker": null,
          "content": "相册扉页写着一行已经褪色的小字：一九五一年，青岛。",
          "portraitRef": null,
          "effectRef": "cg:hua/prologue/photo_album",
          "orderIndex": 1,
          "condition": null
        },
        {
          "code": "hua_prologue_003",
          "lineType": "dialogue",
          "speaker": "主角",
          "content": "照片里的人是谁？这座红楼……又在哪里见过？",
          "portraitRef": "protagonist/thinking",
          "effectRef": null,
          "orderIndex": 2,
          "condition": null
        },
        {
          "code": "hua_prologue_004",
          "lineType": "narration",
          "speaker": null,
          "content": "指尖触到照片的一刻，海风与蝉鸣忽然从纸页深处涌来。",
          "portraitRef": null,
          "effectRef": "transition:memory_enter",
          "orderIndex": 3,
          "condition": null
        }
      ],
      "choices": []
    },
    {
      "code": "hua_letter",
      "type": "normal",
      "title": "第一幕：跨越千里的通知书",
      "entry": false,
      "showInStoryline": true,
      "progressPercent": 5,
      "backgroundRef": "hua/act1/home_1951",
      "cgRef": "hua/act1/admission_letter",
      "nextNodeCode": "hua_dorm",
      "lines": [
        {
          "code": "hua_letter_001",
          "lineType": "narration",
          "speaker": null,
          "content": "1951年初春。你展开那封带着淡淡墨香的录取通知书，信封上端端正正印着“录取通知书”五个字。",
          "portraitRef": null,
          "effectRef": null,
          "orderIndex": 0,
          "condition": null
        },
        {
          "code": "hua_letter_002",
          "lineType": "dialogue",
          "speaker": "你",
          "content": "山东大学，青岛……真的要离开家了。",
          "portraitRef": "hua/protagonist/young_normal",
          "effectRef": null,
          "orderIndex": 1,
          "condition": null
        },
        {
          "code": "hua_letter_003",
          "lineType": "narration",
          "speaker": null,
          "content": "你将通知书仔细折好，贴身放进口袋。你知道，从这一刻起，人生将与那座海滨城市、与一所正在经历伟大变革的大学紧紧相连。",
          "portraitRef": null,
          "effectRef": null,
          "orderIndex": 2,
          "condition": null
        },
        {
          "code": "hua_letter_004",
          "lineType": "effect",
          "speaker": null,
          "content": "列车向东，窗外的土地不断退去，海风渐渐有了咸湿的气息。",
          "portraitRef": null,
          "effectRef": "transition:train_to_qingdao",
          "orderIndex": 3,
          "condition": null
        }
      ],
      "choices": []
    },
    {
      "code": "hua_dorm",
      "type": "normal",
      "title": "第一幕：红楼里的新居",
      "entry": false,
      "showInStoryline": true,
      "progressPercent": 10,
      "backgroundRef": "hua/act1/red_building_dorm",
      "cgRef": null,
      "nextNodeCode": "hua_ceremony_meet",
      "lines": [
        {
          "code": "hua_dorm_001",
          "lineType": "narration",
          "speaker": null,
          "content": "几天后，你背着简单的行囊来到青岛。鱼山路上的老校舍古木参天，红楼掩映。",
          "portraitRef": null,
          "effectRef": null,
          "orderIndex": 0,
          "condition": null
        },
        {
          "code": "hua_dorm_002",
          "lineType": "narration",
          "speaker": null,
          "content": "宿舍里是一张硬板床和一张斑驳的旧书桌，空气中混着旧木头与淡淡霉味。",
          "portraitRef": null,
          "effectRef": null,
          "orderIndex": 1,
          "condition": null
        },
        {
          "code": "hua_dorm_003",
          "lineType": "effect",
          "speaker": null,
          "content": "整理行囊：铺好粗布床单，放稳搪瓷茶缸，将钢笔、笔记本和旧书摆上桌面。",
          "portraitRef": null,
          "effectRef": "minigame:hua/organize_luggage",
          "orderIndex": 2,
          "condition": null
        },
        {
          "code": "hua_dorm_004",
          "lineType": "dialogue",
          "speaker": "你",
          "content": "床板虽然硬，总比从前漏雨的土炕强。把床铺平，今晚就能伴着海浪声入睡。",
          "portraitRef": "hua/protagonist/young_pleased",
          "effectRef": null,
          "orderIndex": 3,
          "condition": null
        },
        {
          "code": "hua_dorm_005",
          "lineType": "dialogue",
          "speaker": "你",
          "content": "桌子再旧，擦干净了就是我的阵地。笔墨要备齐，教授们讲的每一句都不能错过。",
          "portraitRef": "hua/protagonist/young_determined",
          "effectRef": null,
          "orderIndex": 4,
          "condition": null
        },
        {
          "code": "hua_dorm_006",
          "lineType": "narration",
          "speaker": null,
          "content": "夕阳透过吱呀作响的木窗棂，给斑驳的墙壁镀上金边。简陋的房间里，正生长着蓬勃的新生活。",
          "portraitRef": null,
          "effectRef": null,
          "orderIndex": 5,
          "condition": null
        },
        {
          "code": "hua_dorm_007",
          "lineType": "effect",
          "speaker": null,
          "content": "夜幕即将降临。明天，就是开学典礼暨合校成功庆祝大会。",
          "portraitRef": null,
          "effectRef": "overlay:date_1951_03_18",
          "orderIndex": 6,
          "condition": null
        }
      ],
      "choices": []
    },
    {
