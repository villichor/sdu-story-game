        {
          "code": "pan_prologue_002",
          "lineType": "dialogue",
          "speaker": "主角",
          "content": "潘承洞……解析数论……为哥德巴赫猜想做出重要贡献……",
          "portraitRef": "protagonist/normal",
          "effectRef": null,
          "orderIndex": 1,
          "condition": null
        },
        {
          "code": "pan_prologue_003",
          "lineType": "dialogue",
          "speaker": "主角",
          "content": "著书立说……曾担任山东大学校长，培养人才……当选中国科学院院士……确实是很伟大的数学家呢。",
          "portraitRef": "protagonist/normal",
